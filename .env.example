# Копируется в apps/web/.env.local (Vite читает только переменные с префиксом VITE_).
# В браузер попадают ТОЛЬКО публичные значения. Секреты (service_role, X/Threads/Stripe/LLM ключи)
# в это приложение не кладём никогда: они будут жить в секретах Supabase Edge Functions.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
